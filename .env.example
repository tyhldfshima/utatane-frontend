# utatane-frontend — 環境変数サンプル

# バックエンドAPIのベースURL（/api/* のrewrite先）
NEXT_PUBLIC_API_URL=https://web-production-c9b1.up.railway.app

# 完全メンテナンス画面のON/OFFフラグ。
# 'on' / '1' / 'true' のとき、全アクセスをメンテ画面(/maintenance.html)へ差し替える。
# 未設定 / 'off' のときは通常表示（既存LP・全ルートがそのまま動作）。
# 本番でのONは Vercel ダッシュボードで MAINTENANCE_MODE=on を追加→再デプロイ。
MAINTENANCE_MODE=off
